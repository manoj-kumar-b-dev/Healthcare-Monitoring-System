# ─────────────────────────────────────────────────────────
# Healthcare Monitoring System — Frontend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env file to version control.
# All variables MUST be prefixed with VITE_ to be exposed to the browser.
# ─────────────────────────────────────────────────────────

# Backend API base URL (must include /api suffix)
# Local dev:  http://localhost:5000/api
# Production: https://your-backend-domain.com/api
VITE_API_URL=https://your-backend-domain.com/api

# Backend Socket.IO URL (no /api suffix — root URL)
# Local dev:  http://localhost:5000
# Production: https://your-backend-domain.com
VITE_SOCKET_URL=https://your-backend-domain.com
