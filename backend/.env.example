# ─────────────────────────────────────────────────────────
# Healthcare Monitoring System — Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env file to version control.
# ─────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=production

# Frontend URL (used for CORS — comma-separate multiple origins)
# Local dev:      http://localhost:5173
# Production:     https://your-app.vercel.app
FRONTEND_URL=https://your-frontend-domain.com

# Backend URL (used by keep-warm self-ping to prevent Render cold starts)
# Production:  https://your-backend.onrender.com
BACKEND_URL=https://your-backend.onrender.com

# MongoDB
MONGODB_URI=your_mongodb_connection_string
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_strong_jwt_secret_min_32_chars
JWT_EXPIRE=30d

# ─── Email Configuration (Resend or Gmail OAuth2) ───
# Render's free tier blocks SMTP ports (587/465). Both of the below methods
# communicate over HTTPS (port 443) and will work perfectly on Render.

# OPTION A: Resend API (Primary / Recommended — 1 min setup)
# Get a free API key by signing up at https://resend.com (no custom domain required to send to yourself)
RESEND_API_KEY=re_your_api_key_here

# OPTION B: Gmail OAuth2 (Backup — 10 min setup)
# Setup (one-time):
#  1. Go to console.cloud.google.com -> Credentials -> Create OAuth2 Client ID (Web Application)
#     - Authorized redirect URI: https://developers.google.com/oauthplayground
#  2. Enable Gmail API: console.cloud.google.com -> APIs & Services -> Library -> search "Gmail API" -> Enable
#  3. Go to developers.google.com/oauthplayground -> Gear (top-right) -> Check "Use own OAuth credentials"
#     - Input Client ID + Secret -> Select scope: https://mail.google.com/ -> Authorize -> Exchange code -> Copy Refresh Token
EMAIL_USER=your_gmail_address@gmail.com
GMAIL_CLIENT_ID=your_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_client_secret
GMAIL_REFRESH_TOKEN=your_refresh_token

# ─── SMS (Twilio) ───
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: only if not using Messaging Service SID
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
